# Generated by ./setup-cloudflare-tunnel.sh wsl-ip or install-coolify.
# Do not commit the real .env.local because WSL IPs are machine-local state.

export WSL_IP="127.0.0.1"
export COOLIFY_DASHBOARD_PORT="8000"
export COOLIFY_DASHBOARD_URL="http://127.0.0.1:8000"
export COOLIFY_LOOPBACK_URL="http://127.0.0.1:8000"
export COOLIFY_PROXY_URL="http://127.0.0.1:80"
